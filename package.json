{
  "name": "deadfall",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts README.md index.html package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts README.md index.html package.json tsconfig.json",
    "build:standalone": "npm run build && node scripts/package-game.mjs",
    "review:animation": "node scripts/review-animation.mjs",
    "test:standalone": "node scripts/check-standalone.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
